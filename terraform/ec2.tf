################################################################################
# AMI: Ubuntu 20.04 LTS (Focal) — intentionally outdated
# Standard support ended April 2025 (1+ year ago), MongoDB 5.0 supports focal
# and is also EOL (October 2024) — satisfies both outdated OS + DB requirements
################################################################################
data "aws_ami" "ubuntu_2004" {
  most_recent = true
  owners      = ["099720109477"] # Canonical official

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

################################################################################
# Key Pair — generated by Terraform, private key saved locally
################################################################################
resource "tls_private_key" "mongodb" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "mongodb" {
  key_name   = "${var.project_name}-key"
  public_key = tls_private_key.mongodb.public_key_openssh
}

# Save the private key to disk so you can SSH in if needed
resource "local_sensitive_file" "mongodb_private_key" {
  content         = tls_private_key.mongodb.private_key_pem
  filename        = "${path.module}/../wiz-exercise-key.pem"
  file_permission = "0400"
}

################################################################################
# EC2 Instance: MongoDB Server
# Intentional weaknesses:
#   - Ubuntu 18.04 LTS (EOL, 1+ year outdated)
#   - MongoDB 4.4 (outdated version)
#   - SSH open to 0.0.0.0/0
#   - Overly permissive IAM role attached
################################################################################

locals {
  # templatefile() reads an external .sh file — avoids the heredoc indentation
  # bug that strips the shebang and causes "Exec format error" in cloud-init
  mongodb_user_data = templatefile("${path.module}/scripts/mongodb-userdata.sh.tpl", {
    mongodb_username     = var.mongodb_username
    mongodb_password     = var.mongodb_password
    mongodb_app_username = var.mongodb_app_username
    mongodb_app_password = var.mongodb_app_password
    s3_bucket_name       = local.s3_bucket_name
    aws_region           = var.aws_region
  })
}

resource "aws_instance" "mongodb" {
  ami                    = data.aws_ami.ubuntu_2004.id
  instance_type          = var.mongodb_instance_type
  subnet_id              = aws_subnet.public[0].id
  key_name               = aws_key_pair.mongodb.key_name
  vpc_security_group_ids = [aws_security_group.mongodb_ec2.id]
  iam_instance_profile   = aws_iam_instance_profile.mongodb_ec2_profile.name

  # INTENTIONAL WEAKNESS: public IP assigned
  associate_public_ip_address = true

  user_data = local.mongodb_user_data

  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = false # INTENTIONAL WEAKNESS: unencrypted root volume
  }

  tags = {
    Name = "${var.project_name}-mongodb"
    Note = "Intentionally outdated OS and MongoDB for Wiz exercise"
  }
}
